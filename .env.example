# App
APP_NAME=RAG Document Assistant
APP_ENV=local

# Embeddings
EMBEDDINGS_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# For offline smoke tests or broken ML environments, use:
# EMBEDDINGS_MODEL_NAME=hash

# Model provider: ollama, openai, anthropic, google
LLM_PROVIDER=ollama
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=120

# Ollama / local model
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Hosted model options
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GOOGLE_MODEL=gemini-1.5-flash

# Retrieval
CHUNK_SIZE=500
CHUNK_OVERLAP=200
RETRIEVAL_K=8
RETRIEVAL_FETCH_K=24
RETRIEVAL_LAMBDA_MULT=0.35
MAX_CONTEXT_DOCS=8
MULTI_QUERY_COUNT=3
KEYWORD_RETRIEVAL_K=8
MIN_ANSWER_CONFIDENCE=0.35

# Storage
VECTORSTORE_DIR=.rag_index
INDEX_MANIFEST_PATH=.rag_index/manifest.json
MAX_UPLOAD_MB=50

# Frontend -> Backend mode
APP_USE_BACKEND_API=false
BACKEND_API_URL=http://localhost:8000
