# Embeddings
EMBEDDINGS_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Ollama / Llama 3
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Retrieval
CHUNK_SIZE=500
CHUNK_OVERLAP=200
RETRIEVAL_K=8
RETRIEVAL_FETCH_K=24
RETRIEVAL_LAMBDA_MULT=0.35
MAX_CONTEXT_DOCS=8

# Storage
VECTORSTORE_DIR=.rag_index

# Frontend -> Backend mode
APP_USE_BACKEND_API=false
BACKEND_API_URL=http://localhost:8000
